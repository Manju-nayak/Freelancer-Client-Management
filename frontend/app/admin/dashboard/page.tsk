"use client";

import { useState } from "react";
import Link from "next/link";

const initialUsers = [
  {
    id: 1,
    name: "Rahul Sharma",
    email: "rahul@gmail.com",
    role: "Client",
    status: "Active",
  },
  {
    id: 2,
    name: "Arjun Reddy",
    email: "arjun@gmail.com",
    role: "Freelancer",
    status: "Active",
  },
  {
    id: 3,
    name: "Priya Kumar",
    email: "priya@gmail.com",
    role: "Client",
    status: "Active",
  },
  {
    id: 4,
    name: "Sneha Patel",
    email: "sneha@gmail.com",
    role: "Freelancer",
    status: "Inactive",
  },
];

const projects = [
  {
    id: "PRJ001",
    name: "React Website Development",
    client: "Rahul Sharma",
    freelancer: "Arjun Reddy",
    status: "In Progress",
    budget: 15000,
  },
  {
    id: "PRJ002",
    name: "UI/UX Dashboard Design",
    client: "Priya Kumar",
    freelancer: "Sneha Patel",
    status: "Completed",
    budget: 8000,
  },
  {
    id: "PRJ003",
    name: "E-commerce Website",
    client: "Rahul Sharma",
    freelancer: "Arjun Reddy",
    status: "Pending",
    budget: 12000,
  },
];

export default function AdminDashboard() {
  const [users, setUsers] = useState(initialUsers);
  const [userFilter, setUserFilter] = useState("All");
  const [search, setSearch] = useState("");

  const totalClients = users.filter(
    (user) => user.role === "Client"
  ).length;

  const totalFreelancers = users.filter(
    (user) => user.role === "Freelancer"
  ).length;

  const filteredUsers = users.filter((user) => {
    const matchesRole =
      userFilter === "All" || user.role === userFilter;

    const matchesSearch =
      user.name.toLowerCase().includes(search.toLowerCase()) ||
      user.email.toLowerCase().includes(search.toLowerCase());

    return matchesRole && matchesSearch;
  });

  const toggleUserStatus = (id: number) => {
    setUsers((currentUsers) =>
      currentUsers.map((user) =>
        user.id === id
          ? {
              ...user,
              status: user.status === "Active" ? "Inactive" : "Active",
            }
          : user
      )
    );
  };

  return (
    <div className="min-h-screen bg-gray-100">

      {/* Top Navigation */}
      <header className="flex flex-col justify-between gap-3 bg-white px-6 py-5 shadow-sm sm:flex-row sm:items-center">
        <div>
          <h1 className="text-2xl font-bold text-blue-700">
            FreelanceHub
          </h1>
          <p className="text-sm text-gray-500">
            Administration Panel
          </p>
        </div>

        <div className="flex items-center gap-3">
          <span className="rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700">
            Administrator
          </span>

          <Link
            href="/"
            className="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
          >
            Logout
          </Link>
        </div>
      </header>

      <main className="mx-auto max-w-7xl p-6 md:p-8">

        {/* Welcome */}
        <div className="mb-8">
          <h2 className="text-3xl font-bold text-gray-900">
            Admin Dashboard
          </h2>

          <p className="mt-2 text-gray-500">
            Monitor and manage your FreelanceHub platform.
          </p>
        </div>

        {/* Statistics Cards */}
        <div className="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">

          <div className="rounded-xl bg-white p-6 shadow-sm">
            <p className="text-sm text-gray-500">
              Total Users
            </p>

            <h3 className="mt-3 text-3xl font-bold text-gray-900">
              {users.length}
            </h3>

            <p className="mt-2 text-sm text-blue-600">
              Registered platform users
            </p>
          </div>

          <div className="rounded-xl bg-white p-6 shadow-sm">
            <p className="text-sm text-gray-500">
              Total Clients
            </p>

            <h3 className="mt-3 text-3xl font-bold text-blue-600">
              {totalClients}
            </h3>

            <p className="mt-2 text-sm text-gray-500">
              Registered clients
            </p>
          </div>

          <div className="rounded-xl bg-white p-6 shadow-sm">
            <p className="text-sm text-gray-500">
              Total Freelancers
            </p>

            <h3 className="mt-3 text-3xl font-bold text-purple-600">
              {totalFreelancers}
            </h3>

            <p className="mt-2 text-sm text-gray-500">
              Registered freelancers
            </p>
          </div>

          <div className="rounded-xl bg-white p-6 shadow-sm">
            <p className="text-sm text-gray-500">
              Total Projects
            </p>

            <h3 className="mt-3 text-3xl font-bold text-green-600">
              {projects.length}
            </h3>

            <p className="mt-2 text-sm text-gray-500">
              Projects on the platform
            </p>
          </div>

        </div>

        {/* Project Statistics */}
        <div className="mb-8 grid grid-cols-1 gap-5 md:grid-cols-3">

          <div className="rounded-xl border-l-4 border-blue-500 bg-white p-6 shadow-sm">
            <p className="text-gray-500">
              In Progress Projects
            </p>

            <h3 className="mt-2 text-2xl font-bold text-blue-600">
              {projects.filter((p) => p.status === "In Progress").length}
            </h3>
          </div>

          <div className="rounded-xl border-l-4 border-green-500 bg-white p-6 shadow-sm">
            <p className="text-gray-500">
              Completed Projects
            </p>

            <h3 className="mt-2 text-2xl font-bold text-green-600">
              {projects.filter((p) => p.status === "Completed").length}
            </h3>
          </div>

          <div className="rounded-xl border-l-4 border-orange-500 bg-white p-6 shadow-sm">
            <p className="text-gray-500">
              Pending Projects
            </p>

            <h3 className="mt-2 text-2xl font-bold text-orange-500">
              {projects.filter((p) => p.status === "Pending").length}
            </h3>
          </div>

        </div>

        {/* Payment Overview */}
        <div className="mb-8 rounded-xl bg-white p-6 shadow-sm">

          <h3 className="text-xl font-bold text-gray-900">
            Payment Overview
          </h3>

          <div className="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">

            <div>
              <p className="text-sm text-gray-500">
                Total Payment Volume
              </p>

              <h3 className="mt-2 text-2xl font-bold text-gray-900">
                ₹40,000
              </h3>
            </div>

            <div>
              <p className="text-sm text-gray-500">
                Completed Payments
              </p>

              <h3 className="mt-2 text-2xl font-bold text-green-600">
                ₹27,000
              </h3>
            </div>

            <div>
              <p className="text-sm text-gray-500">
                Pending Payments
              </p>

              <h3 className="mt-2 text-2xl font-bold text-orange-500">
                ₹8,000
              </h3>
            </div>

          </div>
        </div>

        {/* User Management */}
        <div className="mb-8 overflow-hidden rounded-xl bg-white shadow-sm">

          <div className="flex flex-col justify-between gap-4 border-b p-6 md:flex-row md:items-center">

            <div>
              <h3 className="text-xl font-bold text-gray-900">
                User Management
              </h3>

              <p className="mt-1 text-sm text-gray-500">
                View and manage registered users.
              </p>
            </div>

            <div className="flex flex-col gap-3 sm:flex-row">

              <input
                type="text"
                placeholder="Search users..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                className="rounded-lg border border-gray-300 px-4 py-2 outline-none focus:border-blue-500"
              />

              <select
                value={userFilter}
                onChange={(e) => setUserFilter(e.target.value)}
                className="rounded-lg border border-gray-300 px-4 py-2 outline-none focus:border-blue-500"
              >
                <option value="All">All Users</option>
                <option value="Client">Clients</option>
                <option value="Freelancer">Freelancers</option>
              </select>

            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full min-w-[650px] text-left">

              <thead className="bg-gray-50 text-sm text-gray-500">
                <tr>
                  <th className="px-6 py-4">User</th>
                  <th className="px-6 py-4">Email</th>
                  <th className="px-6 py-4">Role</th>
                  <th className="px-6 py-4">Status</th>
                  <th className="px-6 py-4">Action</th>
                </tr>
              </thead>

              <tbody className="divide-y divide-gray-100">

                {filteredUsers.map((user) => (
                  <tr key={user.id} className="hover:bg-gray-50">

                    <td className="px-6 py-4 font-medium text-gray-900">
                      {user.name}
                    </td>

                    <td className="px-6 py-4 text-gray-600">
                      {user.email}
                    </td>

                    <td className="px-6 py-4 text-gray-600">
                      {user.role}
                    </td>

                    <td className="px-6 py-4">
                      <span
                        className={`rounded-full px-3 py-1 text-xs font-semibold ${
                          user.status === "Active"
                            ? "bg-green-100 text-green-700"
                            : "bg-red-100 text-red-700"
                        }`}
                      >
                        {user.status}
                      </span>
                    </td>

                    <td className="px-6 py-4">
                      <button
                        onClick={() => toggleUserStatus(user.id)}
                        className="font-medium text-blue-600 hover:underline"
                      >
                        {user.status === "Active" ? "Deactivate" : "Activate"}
                      </button>
                    </td>

                  </tr>
                ))}

              </tbody>

            </table>

            {filteredUsers.length === 0 && (
              <p className="p-8 text-center text-gray-500">
                No users found.
              </p>
            )}
          </div>

        </div>

        {/* Project Management */}
        <div className="overflow-hidden rounded-xl bg-white shadow-sm">

          <div className="border-b p-6">
            <h3 className="text-xl font-bold text-gray-900">
              Project Monitoring
            </h3>

            <p className="mt-1 text-sm text-gray-500">
              Monitor projects posted on the platform.
            </p>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full min-w-[750px] text-left">

              <thead className="bg-gray-50 text-sm text-gray-500">
                <tr>
                  <th className="px-6 py-4">Project ID</th>
                  <th className="px-6 py-4">Project</th>
                  <th className="px-6 py-4">Client</th>
                  <th className="px-6 py-4">Freelancer</th>
                  <th className="px-6 py-4">Budget</th>
                  <th className="px-6 py-4">Status</th>
                </tr>
              </thead>

              <tbody className="divide-y divide-gray-100">

                {projects.map((project) => (
                  <tr key={project.id} className="hover:bg-gray-50">

                    <td className="px-6 py-4 font-medium text-blue-600">
                      {project.id}
                    </td>

                    <td className="px-6 py-4 text-gray-800">
                      {project.name}
                    </td>

                    <td className="px-6 py-4 text-gray-600">
                      {project.client}
                    </td>

                    <td className="px-6 py-4 text-gray-600">
                      {project.freelancer}
                    </td>

                    <td className="px-6 py-4 font-semibold text-gray-900">
                      ₹{project.budget.toLocaleString("en-IN")}
                    </td>

                    <td className="px-6 py-4">
                      <span
                        className={`rounded-full px-3 py-1 text-xs font-semibold ${
                          project.status === "Completed"
                            ? "bg-green-100 text-green-700"
                            : project.status === "In Progress"
                            ? "bg-blue-100 text-blue-700"
                            : "bg-orange-100 text-orange-700"
                        }`}
                      >
                        {project.status}
                      </span>
                    </td>

                  </tr>
                ))}

              </tbody>
            </table>
          </div>

        </div>

        {/* Footer */}
        <div className="mt-8 text-center text-sm text-gray-400">
          FreelanceHub Admin Panel © 2026
        </div>

      </main>
    </div>
  );
}